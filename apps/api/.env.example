# ─── Database ────────────────────────────────────────────────────────────────
# Postgres database connection string (local Docker default or Neon PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusoj?schema=public"
DATABASE_URL_POOLED="postgresql://postgres:postgres@localhost:5432/campusoj?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-replace-in-production-campusoj-2026
JWT_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Client ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis connection URL for BullMQ submission queue
REDIS_URL="redis://localhost:6379"

# ─── Judge Worker ────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
