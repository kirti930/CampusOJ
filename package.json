{
  "name": "campusoj",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "judge/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@campusoj/api",
    "dev:web": "npm run dev --workspace=@campusoj/web",
    "dev:worker": "npm run dev --workspace=@campusoj/judge-worker",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=packages/db",
    "db:migrate": "npm run db:migrate --workspace=packages/db",
    "db:seed": "npm run db:seed --workspace=packages/db",
    "db:import:sheet": "tsx packages/db/prisma/import-curated-sheet.ts",
    "db:studio": "npm run db:studio --workspace=packages/db",
    "test:smoke": "tsx tests/smoke-test.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
