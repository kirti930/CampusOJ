# =============================================================================
# CampusOJ Environment Variables Configuration
# =============================================================================
# Copy this file to `.env` in the root of the project:
#   cp .env.example .env
# =============================================================================

# ─── Database (PostgreSQL 16) ────────────────────────────────────────────────
# Connection string for PostgreSQL database.
# Local Docker default: postgresql://postgres:postgres@localhost:5432/campusoj?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusoj?schema=public

# ─── Security & Authentication ───────────────────────────────────────────────
# Secret key used to sign and verify JSON Web Tokens (JWT).
# Generate a secure 64-char string: openssl rand -base64 32
JWT_SECRET=super-secret-jwt-key-replace-in-production-campusoj-2026

# Token expiration duration (e.g., "7d", "24h", "60m")
JWT_EXPIRES_IN=7d

# ─── API Server ──────────────────────────────────────────────────────────────
# Port where Express API listens
PORT=5000

# Environment mode: "development" | "production" | "test"
NODE_ENV=development

# ─── Web Frontend Client ─────────────────────────────────────────────────────
# Allowed CORS origin URL for frontend client
CLIENT_URL=http://localhost:5173

# ─── Redis & Queue ───────────────────────────────────────────────────────────
# Redis connection string for BullMQ submission background jobs.
# Local Docker default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ─── Code Execution & Judge Engine ───────────────────────────────────────────
# Evaluation engine provider: "mock" (offline/local simulation) or "judge0"
JUDGE_PROVIDER=mock

# Judge0 API Base URL (Self-hosted or RapidAPI endpoint)
# Self-hosted default: http://localhost:2358
# RapidAPI URL: https://judge0-ce.p.rapidapi.com
JUDGE0_BASE_URL=http://localhost:2358

# Judge0 API Key (required when using RapidAPI; leave empty for self-hosted CE)
JUDGE0_API_KEY=

# Maximum number of concurrent submission evaluation jobs in the worker
WORKER_CONCURRENCY=2
