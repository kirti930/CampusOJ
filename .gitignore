# ==========================================
# CampusOJ Monorepo .gitignore
# ==========================================

# ─── Dependencies ─────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment Variables & Secrets ──────
.env
.env.*
*.env
*.env.*
!*.env.example
!.env.example

# ─── Build Artifacts & Caches ─────────────
dist/
build/
out/
.next/
.vite/
*.tsbuildinfo
.turbo/
.cache/

# ─── Logs & Process Dumps ─────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Testing & Coverage ───────────────────
coverage/
.nyc_output/
*.lcov

# ─── Database & SQLite ────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal

# ─── Sandboxed Execution & Binaries ───────
temp/
tmp/
*.o
*.obj
*.exe
*.class
*.out
*.app
__pycache__/
*.py[cod]
*$py.class

# ─── OS Files ─────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ─── IDE & Editor Configurations ──────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── Scratch & Agent Artifacts ────────────
scratch/
